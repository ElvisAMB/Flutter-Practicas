{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RAT: instalar dependencias",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "RAT: generar llaves de cifrado",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py generar_llave",
      "detail": "Copie el resultado en el archivo .env antes de migrar.",
      "problemMatcher": []
    },
    {
      "label": "RAT: crear migraciones",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py makemigrations",
      "problemMatcher": []
    },
    {
      "label": "RAT: aplicar migraciones",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py migrate",
      "problemMatcher": []
    },
    {
      "label": "RAT: cargar datos iniciales",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py inicializar",
      "detail": "Perfiles fijos, catálogos base y 11 plantillas. Idempotente.",
      "problemMatcher": []
    },
    {
      "label": "RAT: ejecutar pruebas",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py test apps -v 2",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "RAT: verificar integridad de bitácora",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py verificar_bitacora",
      "problemMatcher": []
    },
    {
      "label": "RAT: check de despliegue",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py check --deploy",
      "detail": "Ejecutar con DJANGO_SETTINGS_MODULE=config.settings.prod para el resultado real.",
      "problemMatcher": []
    },
    {
      "label": "RAT: recolectar estáticos",
      "type": "shell",
      "command": "${command:python.interpreterPath} manage.py collectstatic --noinput",
      "problemMatcher": []
    },
    {
      "label": "RAT: puesta a punto completa",
      "dependsOrder": "sequence",
      "dependsOn": [
        "RAT: instalar dependencias",
        "RAT: aplicar migraciones",
        "RAT: cargar datos iniciales",
        "RAT: ejecutar pruebas"
      ],
      "problemMatcher": []
    }
  ]
}
